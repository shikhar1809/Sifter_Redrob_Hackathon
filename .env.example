# App
NODE_ENV=development
WEB_ORIGIN=http://127.0.0.1:3000
VITE_API_BASE_URL=http://127.0.0.1:4000

# API
API_HOST=127.0.0.1
API_PORT=4000
AUTH_REQUIRED=false
KEYCLOAK_JWKS_URL=http://127.0.0.1:8080/realms/seederpro/protocol/openid-connect/certs
KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/seederpro

# Postgres + pgvector
DATABASE_URL=postgres://seederpro:seederpro@127.0.0.1:5432/seederpro

# Open-source LLM server, vLLM/Ollama OpenAI-compatible endpoint
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5-7b-instruct

# Optional Gemini reviewer. Put the real key only in local .env, never in frontend code.
# Rotate the key before deployment if it has ever been shared in chat, screenshots, or logs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REVIEW_ENABLED=true

# Object storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=seederpro
S3_SECRET_KEY=seederpro-secret
S3_BUCKET=seederpro

# Queue/cache services
NATS_URL=nats://127.0.0.1:4222
VALKEY_URL=redis://127.0.0.1:6379
