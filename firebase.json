{
  "hosting": {
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/health",
        "run": {
          "serviceId": "sifter-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/csv/**",
        "run": {
          "serviceId": "sifter-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/redrob/**",
        "run": {
          "serviceId": "sifter-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/pipeline-runs",
        "run": {
          "serviceId": "sifter-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
